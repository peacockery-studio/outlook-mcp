{
	"name": "@peacockery-studio/outlook-mcp",
	"version": "2.0.0",
	"description": "MCP server for Claude to access Outlook data via Microsoft Graph API",
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"start": "bun run index.ts",
		"test-mode": "USE_TEST_MODE=true bun run index.ts",
		"inspect": "bunx @modelcontextprotocol/inspector bun run index.ts",
		"test": "bun test",
		"lint": "bunx ultracite check",
		"lint:fix": "bunx ultracite fix",
		"format": "bunx ultracite fix",
		"typecheck": "bunx tsc --noEmit"
	},
	"keywords": [
		"claude",
		"outlook",
		"mcp",
		"model-context-protocol",
		"microsoft-graph",
		"email",
		"calendar",
		"anthropic"
	],
	"author": "Chi Ejimofor",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/peacockery-studio/outlook-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/peacockery-studio/outlook-mcp/issues"
	},
	"homepage": "https://github.com/peacockery-studio/outlook-mcp#readme",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.26.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@modelcontextprotocol/inspector": "^0.17.5",
		"@types/node": "^22.0.0",
		"bun-types": "^1.2.0",
		"typescript": "^5.7.0"
	}
}
